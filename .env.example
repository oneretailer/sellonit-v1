# ─────────────────────────────────────────────────────────────────────────────
# Sellonit — environment variables
#
#   cp .env.example .env
#
# The root .env is read by the api and worker dev scripts, the Prisma CLI,
# the integration test configs and docker compose. apps/web is different —
# see its section. Never commit .env. Never put real secrets in this file.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Local infrastructure (docker compose) ────────────────────────────────────
POSTGRES_USER=sellonit
# Local development only. Choose any value; it must match DATABASE_URL below.
POSTGRES_PASSWORD=sellonit_local_dev_only
POSTGRES_DB=sellonit
POSTGRES_PORT=5432
REDIS_PORT=6379

# ── Connections (api, worker) ────────────────────────────────────────────────
# Inside docker compose the hosts are overridden to `postgres` / `redis`.
DATABASE_URL=postgresql://sellonit:sellonit_local_dev_only@localhost:5432/sellonit?schema=public
REDIS_URL=redis://localhost:6379

# ── API (apps/api) ───────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=4000
JWT_SECRET='randomly-generated-secret-value'

# ── Web (apps/web) ───────────────────────────────────────────────────────────
# Next.js loads env from apps/web/.env* only. For local dev, either export these
# or copy them to apps/web/.env.local. Defaults work for a local setup.
#
# Where the Next.js server reaches the API (no /v1 suffix). Used by the
# /api/v1/* proxy rewrite in next.config.ts, which is fixed at BUILD time.
API_INTERNAL_URL=http://localhost:4000
# `next dev` only: extra hostnames allowed to load dev assets/HMR (comma-separated,
# wildcards allowed), e.g. when using a tunnel or remote preview: *.example.dev
WEB_ALLOWED_DEV_ORIGINS=
