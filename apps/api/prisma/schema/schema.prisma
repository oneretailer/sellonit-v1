// Prisma multi-file schema. Add model files next to this one
// (e.g. prisma/schema/orders.prisma) and run `npm run db:migrate`.

generator client {
  provider            = "prisma-client"
  output              = "../../src/generated/prisma"

  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid())
  firstName       String
  lastName        String
  email           String    @unique
  phone           String?
  passwordHash    String
 
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}
