// Prisma multi-file schema. Add model files next to this one
// (e.g. prisma/schema/orders.prisma) and run `npm run db:migrate`.

generator client {
  provider            = "prisma-client"
  output              = "../../src/generated/prisma"

  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}
