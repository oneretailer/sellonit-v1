{
  "name": "@sellonit/api",
  "version": "0.1.0",
  "private": true,
  "description": "Sellonit REST API (Express). Implements docs/openapi.yaml.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file=../../.env src/main.ts",
    "prebuild": "npm run db:generate",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sellonit/config": "*",
    "@sellonit/queue": "*",
    "@sellonit/shared": "*",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.81.5",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "resend": "^6.1.0",
    "twilio": "^5.10.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "prisma": "^7.10.0",
    "colorette": "^2.0.20",
    "tsx": "^4.23.15"
  }
}
