{
  "name": "sellonit",
  "version": "0.1.0",
  "private": true,
  "description": "Sellonit — virtual-inventory commerce and supply-chain platform (monorepo).",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "prepare:workspace": "npm run build:packages && npm run db:generate",
    "build:packages": "npm run build -w @sellonit/shared -w @sellonit/config -w @sellonit/queue",
    "dev": "npm run prepare:workspace && concurrently --kill-others-on-fail -n api,worker,web -c blue,magenta,green \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @sellonit/api",
    "dev:worker": "npm run dev -w @sellonit/worker",
    "dev:web": "npm run dev -w @sellonit/web",
    "prelint": "npm run prepare:workspace",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretypecheck": "npm run prepare:workspace",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "npm run prepare:workspace",
    "test": "npm run test --workspaces --if-present",
    "pretest:integration": "npm run prepare:workspace",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "db:generate": "npm run db:generate -w @sellonit/api",
    "db:migrate": "npm run db:migrate -w @sellonit/api",
    "db:deploy": "npm run db:deploy -w @sellonit/api",
    "generate:api": "openapi-typescript docs/openapi.yaml -o packages/shared/src/api.d.ts",
    "validate:api": "redocly lint docs/openapi.yaml",
    "check:api-types": "node scripts/check-api-types.mjs",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.3.6",
    "@redocly/cli": "2.54.3",
    "@types/node": "^22.20.4",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "next-openapi-gen": "^0.10.5",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.4"
  }
}
